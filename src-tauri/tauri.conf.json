{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGY Plus",
  "version": "0.1.0",
  "identifier": "com.alexbeatsz.agy-plus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AGY Plus · RT 登录",
        "width": 560,
        "height": 620,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "signingIdentity": "Local Development Code Signing",
      "hardenedRuntime": true
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
